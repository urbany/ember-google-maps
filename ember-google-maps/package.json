{
  "name": "ember-google-maps",
  "version": "7.3.0",
  "description": "A friendly Ember addon for working with Google Maps.",
  "keywords": [
    "ember-addon",
    "emberjs",
    "google maps",
    "g-map",
    "google",
    "map",
    "maps"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sandydoo/ember-google-maps.git"
  },
  "license": "MIT",
  "author": "Sander Melnikov <hey@sandydoo.me>",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "homepage": "https://ember-google-maps.sandydoo.me",
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/sandydoo"
  },
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache\"",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "rollup --config --watch",
    "test": "echo \"A v2 addon does not have tests, run tests in test-app\""
  },
  "peerDependencies": {
    "@ember/test-helpers": ">=3.3.1"
  },
  "dependencies": {
    "@babel/core": "^7.28.6",
    "@ember/test-waiters": "^4.1.0",
    "@embroider/addon-shim": "^1.10.2",
    "broccoli-debug": "^0.6.5",
    "broccoli-funnel": "^3.0.8",
    "camelcase": "^6.3.0",
    "chalk": "^4.1.2",
    "decorator-transforms": "^2.3.2",
    "ember-cli-version-checker": "^5.1.2",
    "ember-concurrency": "^5.1.0",
    "ember-modifier": "^4.2.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "^7.29.2",
    "@embroider/addon-dev": "^8.3.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@ijlee2-frontend-configs/ember-template-lint": "^3.0.0",
    "@ijlee2-frontend-configs/eslint-config-ember": "^3.4.0",
    "@ijlee2-frontend-configs/prettier": "^3.1.1",
    "@ijlee2-frontend-configs/stylelint": "^3.1.3",
    "@rollup/plugin-babel": "^7.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.1",
    "ember-modifier": "^4.3.0",
    "ember-source": "^6.12.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "rollup": "^4.60.3",
    "stylelint": "^17.11.0"
  },
  "engines": {
    "node": ">= 20.11"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "app-js": {
      "./components/-private-api/warn-missing-component.js": "./dist/_app_/components/-private-api/warn-missing-component.js",
      "./components/g-map.js": "./dist/_app_/components/g-map.js",
      "./components/g-map/advanced-marker.js": "./dist/_app_/components/g-map/advanced-marker.js",
      "./components/g-map/autocomplete.js": "./dist/_app_/components/g-map/autocomplete.js",
      "./components/g-map/bicycling-layer.js": "./dist/_app_/components/g-map/bicycling-layer.js",
      "./components/g-map/canvas.js": "./dist/_app_/components/g-map/canvas.js",
      "./components/g-map/circle.js": "./dist/_app_/components/g-map/circle.js",
      "./components/g-map/control.js": "./dist/_app_/components/g-map/control.js",
      "./components/g-map/directions.js": "./dist/_app_/components/g-map/directions.js",
      "./components/g-map/info-window.js": "./dist/_app_/components/g-map/info-window.js",
      "./components/g-map/map-component.js": "./dist/_app_/components/g-map/map-component.js",
      "./components/g-map/marker.js": "./dist/_app_/components/g-map/marker.js",
      "./components/g-map/overlay.js": "./dist/_app_/components/g-map/overlay.js",
      "./components/g-map/polygon.js": "./dist/_app_/components/g-map/polygon.js",
      "./components/g-map/polyline.js": "./dist/_app_/components/g-map/polyline.js",
      "./components/g-map/rectangle.js": "./dist/_app_/components/g-map/rectangle.js",
      "./components/g-map/route.js": "./dist/_app_/components/g-map/route.js",
      "./components/g-map/traffic-layer.js": "./dist/_app_/components/g-map/traffic-layer.js",
      "./components/g-map/transit-layer.js": "./dist/_app_/components/g-map/transit-layer.js",
      "./components/g-map/typical-map-component.js": "./dist/_app_/components/g-map/typical-map-component.js",
      "./components/g-map/waypoint.js": "./dist/_app_/components/g-map/waypoint.js",
      "./helpers/g-map/hash.js": "./dist/_app_/helpers/g-map/hash.js",
      "./modifiers/g-map/did-insert.js": "./dist/_app_/modifiers/g-map/did-insert.js",
      "./services/google-maps-api.js": "./dist/_app_/services/google-maps-api.js"
    },
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "changelog": {
    "labels": {
      "breaking": ":boom: Breaking changes",
      "enhancement": ":star: Features",
      "bug": ":bug: Bug fixes",
      "documentation": ":book: Documentation",
      "dependencies": ":snake: Dependencies",
      "internal": "Internal"
    }
  },
  "release-it": {
    "plugins": {
      "@release-it-plugins/lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": true
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    }
  },
  "exports": {
    "./*": "./dist/*.js",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ]
}
