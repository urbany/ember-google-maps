{
  "name": "ember-google-maps",
  "version": "7.3.0",
  "description": "A friendly Ember addon for working with Google Maps.",
  "keywords": [
    "ember-addon",
    "emberjs",
    "google maps",
    "g-map",
    "google",
    "map",
    "maps"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sandydoo/ember-google-maps.git"
  },
  "license": "MIT",
  "author": "Sander Melnikov <hey@sandydoo.me>",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "homepage": "https://ember-google-maps.sandydoo.me",
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/sandydoo"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each",
    "test:build": "qunit build-tests/build-test.js"
  },
  "peerDependencies": {
    "@ember/test-helpers": ">=3.3.1",
    "@ember/test-waiters": "^4.1.0"
  },
  "dependencies": {
    "@babel/core": "^7.28.6",
    "@ember/string": "^3.1.1",
    "broccoli-debug": "^0.6.5",
    "broccoli-funnel": "^3.0.8",
    "camelcase": "^6.3.0",
    "chalk": "^4.1.2",
    "ember-auto-import": "^2.12.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cli-version-checker": "^5.1.2",
    "ember-concurrency": "^5.1.0",
    "ember-modifier": "^4.2.2",
    "ember-template-imports": "^4.3.0",
    "lodash": "^4.17.21",
    "tracked-maps-and-sets": "^3.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.28.6",
    "@ember/optional-features": "^2.3.0",
    "@embroider/macros": "^1.19.5",
    "@embroider/test-setup": "^4.0.0",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "@release-it-plugins/lerna-changelog": "^6.1.0",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "ember-cli": "~6.9.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.3.3",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-dotenv": "^3.1.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^3.0.1",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.1.1",
    "ember-source": "~6.9.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^6.1.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-qunit": "^8.2.5",
    "globals": "^17.0.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.7.4",
    "prettier-plugin-ember-template-tag": "^2.1.2",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "release-it": "^17.11.0",
    "scenario-tester": "^3.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "webpack": "^5.104.1"
  },
  "engines": {
    "node": ">= 20.11"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "versionCompatibility": {
      "ember": ">=3.28.0"
    },
    "demoURL": "https://ember-google-maps.sandydoo.me"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "changelog": {
    "labels": {
      "breaking": ":boom: Breaking changes",
      "enhancement": ":star: Features",
      "bug": ":bug: Bug fixes",
      "documentation": ":book: Documentation",
      "dependencies": ":snake: Dependencies",
      "internal": "Internal"
    }
  },
  "release-it": {
    "plugins": {
      "@release-it-plugins/lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": true
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    }
  }
}
